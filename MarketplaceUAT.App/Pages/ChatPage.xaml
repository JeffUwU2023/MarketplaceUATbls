<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:MarketplaceUAT.App.Models"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="MarketplaceUAT.App.Pages.ChatPage"
    x:Name="ChatPageRoot"
    Title="Chat"
    BackgroundColor="{AppThemeBinding Light=#F5F6FA, Dark=#15171C}">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto"
          RowSpacing="0">

        <!-- Encabezado -->
        <Grid Grid.Row="0"
      Padding="16,12"
      ColumnDefinitions="*,Auto,Auto"
      BackgroundColor="{AppThemeBinding Light=White, Dark=#20232A}">

            <VerticalStackLayout Spacing="3"
                         VerticalOptions="Center">
                <Label x:Name="TituloChatLabel"
               Text="Conversación"
               FontSize="18"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light=#20232A, Dark=White}" />

                <Label x:Name="SubtituloChatLabel"
               Text="Marketplace"
               FontSize="13"
               TextColor="{AppThemeBinding Light=#666666, Dark=#B8BBC4}" />
            </VerticalStackLayout>

            <ActivityIndicator x:Name="IndicadorCarga"
                       Grid.Column="1"
                       VerticalOptions="Center"
                       Margin="0,0,12,0"
                       IsVisible="False"
                       IsRunning="False"
                       Color="#4169E1" />

            <Button Grid.Column="2"
            Text="Ver perfil"
            FontSize="13"
            Padding="12,8"
            CornerRadius="10"
            BackgroundColor="#4169E1"
            TextColor="White"
            VerticalOptions="Center"
            Clicked="OnVerPerfilClicked" />

        </Grid>

        <!-- Aviso para conversaciones archivadas -->

        <Border x:Name="ConversacionArchivadaBorder"
        Grid.Row="1"
        IsVisible="False"
        Padding="14,10"
        BackgroundColor="{AppThemeBinding Light=#FFF1D6, Dark=#493719}"
        StrokeThickness="0">

            <VerticalStackLayout Spacing="10">

                <Label x:Name="ConversacionArchivadaLabel"
               Text="Esta conversación está archivada. Puedes consultar los mensajes anteriores, pero ya no puedes enviar mensajes."
               FontSize="13"
               TextColor="{AppThemeBinding Light=#754C00, Dark=#FFE0A0}" />

                <Button x:Name="EliminarConversacionButton"
                Text="🗑 Eliminar conversación"
                IsVisible="False"
                HorizontalOptions="Start"
                FontSize="13"
                Padding="12,8"
                CornerRadius="10"
                BackgroundColor="#B91C1C"
                TextColor="White"
                Clicked="OnEliminarConversacionClicked" />

            </VerticalStackLayout>
        </Border>

        <!-- Historial de mensajes -->
        <Grid Grid.Row="2"
              Padding="10,8">

            <Label x:Name="CargandoMensajesLabel"
                   Text="Cargando mensajes..."
                   IsVisible="False"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   FontSize="14"
                   Opacity="0.7" />

            <CollectionView x:Name="MensajesCollectionView"
                            SelectionMode="None"
                            ItemsUpdatingScrollMode="KeepLastItemInView"
                            Scrolled="OnMensajesScrolled">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="8"
                                         Padding="20"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">

                        <Label Text="Todavía no hay mensajes"
                               FontSize="17"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />

                        <Label Text="Envía un mensaje para iniciar la conversación."
                               FontSize="13"
                               Opacity="0.7"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Mensaje">
                        <Grid Padding="0,4">


                            <!-- Mensaje recibido -->
                            <Grid IsVisible="{Binding EsOtro}"
                                  ColumnDefinitions="40,*"
                                  ColumnSpacing="8"
                                  HorizontalOptions="Start"
                                  Margin="0,0,45,0">

                                <!-- Avatar del remitente -->
                                <Border Grid.Column="0"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        BackgroundColor="#DCE8FF"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 18"
                                        VerticalOptions="End">

                                    <Grid>
                                        <Label Text="👤"
                                               FontSize="22"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />

                                        <Image Source="{Binding UrlFotoPerfil}"
                                               Aspect="AspectFill"
                                               IsVisible="{Binding TieneFotoPerfil}" />
                                    </Grid>
                                </Border>

                                <!-- Burbuja del mensaje recibido -->
                                <Border Grid.Column="1"
                                        HorizontalOptions="Start"
                                        MaximumWidthRequest="310"
                                        Padding="11,9"
                                        StrokeThickness="0"
                                        BackgroundColor="{AppThemeBinding Light=White, Dark=#292D35}"
                                        StrokeShape="RoundRectangle 14">

                                    <VerticalStackLayout Spacing="6">

                                        <Label Text="{Binding Contenido}"
                                               IsVisible="{Binding TieneTexto}"
                                               FontSize="15"
                                               LineBreakMode="WordWrap"
                                               TextColor="{AppThemeBinding Light=#202124, Dark=White}" />

                                        <VerticalStackLayout
                                        BindableLayout.ItemsSource="{Binding ImagenesLocales}"
                                        Spacing="6">

                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding .}"
                                                           WidthRequest="220"
                                                           HeightRequest="180"
                                                           Aspect="AspectFit" />
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                        <Label Text="{Binding FechaEnvio, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                               FontSize="10"
                                               HorizontalOptions="End"
                                               Opacity="0.65" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>


                            <!-- Mensaje enviado por el usuario actual -->
                            <Grid IsVisible="{Binding EsMio}"
                                  ColumnDefinitions="*,40"
                                  ColumnSpacing="8"
                                  HorizontalOptions="End"
                                  Margin="45,0,0,0">

                                <Border
                                 Grid.Column="0"
                                 x:Name="MensajePropioBorder"
                                 MaximumWidthRequest="310"
                                 Padding="11,9"
                                 StrokeThickness="0"
                                 BackgroundColor="#DCEAFE"
                                 StrokeShape="RoundRectangle 14">

                                    <Border.Behaviors>
                                        <toolkit:TouchBehavior
                                         BindingContext="{Binding Source={x:Reference MensajePropioBorder},
                                         Path=BindingContext}"
                                         ShouldMakeChildrenInputTransparent="False"
                                         LongPressDuration="1000"
                                         LongPressCommand="{Binding Source={x:Reference ChatPageRoot},
                                         Path=MostrarAccionesCommand}"
                                         LongPressCommandParameter="{Binding Source={x:Reference MensajePropioBorder},
                                         Path=BindingContext}" />
                                    </Border.Behaviors>

                                    <VerticalStackLayout Spacing="6">

                                        <Label Text="{Binding Contenido}"
                                               IsVisible="{Binding TieneTexto}"
                                               FontSize="15"
                                               LineBreakMode="WordWrap"
                                               TextColor="#172554" />

                                        <VerticalStackLayout
                                             BindableLayout.ItemsSource="{Binding ImagenesLocales}"
                                             Spacing="6">

                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding .}"
                                                           WidthRequest="220"
                                                           HeightRequest="180"
                                                           Aspect="AspectFit" />
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                        <Label Text="{Binding FechaEnvio, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                               FontSize="10"
                                               HorizontalOptions="End"
                                               TextColor="#475569" />

                                        <Label Text="{Binding EstadoLectura}"
                                               FontSize="10"
                                               HorizontalOptions="End"
                                               TextColor="#475569" />

                                        <HorizontalStackLayout
                                         HorizontalOptions="End"
                                         Spacing="12">

                                            <Button Text="Editar"
                                                    FontSize="11"
                                                    Padding="5,2"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#1D4ED8"
                                                    CommandParameter="{Binding .}"
                                                    IsVisible="{Binding MostrarBotonEditar}"
                                                    Clicked="OnEditarMensajeClicked" />

                                            <Button Text="Eliminar"
                                                    FontSize="11"
                                                    Padding="5,2"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#B91C1C"
                                                    CommandParameter="{Binding .}"
                                                    IsVisible="{Binding MostrarAcciones}"
                                                    Clicked="OnEliminarMensajeClicked" />
                                        </HorizontalStackLayout>

                                    </VerticalStackLayout>
                                </Border>

                                <!-- Avatar del usuario actual -->
                                <Border Grid.Column="1"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        BackgroundColor="#DCE8FF"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 18"
                                        VerticalOptions="End">

                                    <Grid>
                                        <Label Text="👤"
                                               FontSize="22"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />

                                        <Image Source="{Binding UrlFotoPerfil}"
                                               Aspect="AspectFill"
                                               IsVisible="{Binding TieneFotoPerfil}" />
                                    </Grid>
                                </Border>

                            </Grid>

                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Acceso rápido a los mensajes recientes -->
            <Button x:Name="NuevosMensajesButton"
                    Text="↓"
                    FontSize="24"
                    WidthRequest="46"
                    HeightRequest="46"
                    Padding="0"
                    CornerRadius="23"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,8,8"
                    IsVisible="False"
                    SemanticProperties.Description="Ir a los mensajes más recientes"
                    Clicked="OnNuevosMensajesClicked" />
        </Grid>

        <!-- Vista previa de imágenes antes de enviar -->
        <Border x:Name="ImagenPreviewBorder"
                Grid.Row="3"
                IsVisible="False"
                Padding="8"
                Margin="10,4"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#20232A}"
                Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#414652}"
                StrokeShape="RoundRectangle 12">

            <VerticalStackLayout Spacing="5">

                <Label Text="Imágenes seleccionadas"
                       FontSize="12"
                       FontAttributes="Bold" />

                <CollectionView x:Name="ImagenesPreviewCollectionView"
                                HeightRequest="105"
                                ItemsLayout="HorizontalList"
                                SelectionMode="None">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid WidthRequest="95"
                                  HeightRequest="95"
                                  Margin="0,0,8,0">

                                <Border Padding="2"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8">

                                    <Image Source="{Binding FullPath}"
                                           Aspect="AspectFill" />
                                </Border>

                                <Button Text="✕"
                                        FontSize="11"
                                        WidthRequest="26"
                                        HeightRequest="26"
                                        Padding="0"
                                        CornerRadius="13"
                                        BackgroundColor="#B91C1C"
                                        TextColor="White"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        CommandParameter="{Binding .}"
                                        Clicked="OnEliminarImagenSeleccionadaClicked" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <!-- Área para escribir y enviar -->
        <Grid x:Name="AreaEnvioGrid"
              Grid.Row="4"
              Padding="10,8"
              ColumnDefinitions="48,*,72"
              ColumnSpacing="7"
              BackgroundColor="{AppThemeBinding Light=White, Dark=#20232A}">

            <Button x:Name="SeleccionarImagenButton"
                    Grid.Column="0"
                    Text="＋"
                    FontSize="25"
                    Padding="0"
                    HeightRequest="46"
                    WidthRequest="46"
                    CornerRadius="23"
                    BackgroundColor="{AppThemeBinding Light=#E8EEF9, Dark=#30394A}"
                    TextColor="{AppThemeBinding Light=#1D4ED8, Dark=#BFDBFE}"
                    SemanticProperties.Description="Seleccionar imágenes"
                    Clicked="OnSeleccionarImagenClicked" />

            <Entry x:Name="MensajeEntry"
                   Grid.Column="1"
                   Placeholder="Escribe un mensaje..."
                   MaxLength="1000"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light=#202124, Dark=White}"
                   PlaceholderColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />

            <Button x:Name="EnviarMensajeButton"
                    Grid.Column="2"
                    Text="Enviar"
                    FontSize="13"
                    Padding="5"
                    HeightRequest="46"
                    CornerRadius="12"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    Clicked="OnEnviarMensajeClicked" />
        </Grid>

    </Grid>
</ContentPage>
