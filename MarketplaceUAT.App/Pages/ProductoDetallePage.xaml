<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MarketplaceUAT.App.Pages.ProductoDetallePage"
             Title="Detalle del producto">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="12">

            <CarouselView
                x:Name="ImagenesCarousel"
                HeightRequest="250"
                ItemsSource="{Binding ImagenesProducto}"
                IndicatorView="IndicadorImagenes"
                HorizontalOptions="Fill">

                <CarouselView.ItemTemplate>
                    <DataTemplate>
                        <Image
                Source="{Binding}"
                HeightRequest="250"
                Aspect="AspectFit"
                HorizontalOptions="Fill"
                VerticalOptions="Center" />
                    </DataTemplate>
                </CarouselView.ItemTemplate>

            </CarouselView>

            <IndicatorView
            x:Name="IndicadorImagenes"
            HorizontalOptions="Center" />

            <Image
            x:Name="ImagenPlaceholder"
            Source="dotnet_bot.png"
            HeightRequest="250"
            Aspect="AspectFit"
            IsVisible="False" />

            <Label
                x:Name="NombreProductoLabel"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                x:Name="PrecioProductoLabel"
                FontSize="26" />

            <BoxView
                HeightRequest="1" />

            <Label
                Text="Información del producto"
                FontSize="22"
                FontAttributes="Bold" />

            <Label
                x:Name="CondicionProductoLabel"
                FontSize="18" />


            <Label
    x:Name="EstadoProductoLabel"
    FontSize="18" />

            <Label
    x:Name="CantidadDisponibleLabel"
    FontSize="18"
    TextColor="#218838"
    IsVisible="False" />

            <!-- Selector de cantidad para productos con varias unidades -->
            <VerticalStackLayout
    x:Name="SelectorCantidadLayout"
    Spacing="6"
    IsVisible="False">

                <Label
        Text="Cantidad"
        FontSize="18"
        FontAttributes="Bold" />

                <HorizontalStackLayout
        Spacing="12"
        VerticalOptions="Center">

                    <Button
            x:Name="DisminuirCantidadButton"
            Text="−"
            WidthRequest="48"
            HeightRequest="44"
            Clicked="OnDisminuirCantidadClicked" />

                    <Label
            x:Name="CantidadSeleccionadaLabel"
            Text="1"
            FontSize="20"
            FontAttributes="Bold"
            VerticalTextAlignment="Center"
            HorizontalTextAlignment="Center"
            WidthRequest="40" />

                    <Button
            x:Name="AumentarCantidadButton"
            Text="+"
            WidthRequest="48"
            HeightRequest="44"
            Clicked="OnAumentarCantidadClicked" />

                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Button
    x:Name="AgregarCarritoButton"
    Text="🛒 Agregar al carrito"
    Margin="0,5,0,0"
    BackgroundColor="#218838"
    TextColor="White"
    CornerRadius="10"
    IsVisible="False"
    Clicked="OnAgregarCarritoClicked" />

            <Label
    x:Name="NoDisponibleLabel"
    Text="⚠️ No disponible"
    FontSize="18"
    FontAttributes="Bold"
    TextColor="Red"
    IsVisible="False" />


            <Label
                x:Name="CategoriaProductoLabel"
                FontSize="18" />

            <Label
                Text="Descripción"
                FontSize="22"
                FontAttributes="Bold"
                Margin="0,10,0,0" />

            <Label
                x:Name="DescripcionProductoLabel"
                FontSize="17" />

            <Label
                Text="Información del vendedor"
                FontSize="22"
                FontAttributes="Bold"
                Margin="0,10,0,0" />

            <Label
                x:Name="NombreVendedorLabel"
                FontSize="18" />

            <Label
                x:Name="CorreoVendedorLabel"
                FontSize="17" />

            <Button
                x:Name="VerPerfilVendedorButton"
                Text="👤 Ver perfil"
                Margin="0,5,0,0"
                BackgroundColor="#2457C5"
                TextColor="White"
                CornerRadius="10"
                Clicked="OnVerPerfilVendedorClicked" />

            <Button
                x:Name="AccionProductoButton"
                Text="📩 Contactar vendedor"
                Margin="0,5,0,0"
                Clicked="OnAccionProductoClicked" />

            <Button
                x:Name="EditarPublicacionButton"
                Text="✏️ Editar publicación"
                Margin="0,5,0,0"
                BackgroundColor="#2457C5"
                TextColor="White"
                CornerRadius="10"
                IsVisible="False"
                Clicked="OnEditarPublicacionClicked" />

            <Button
                x:Name="BorrarPublicacionButton"
                Text="🗑 Borrar publicación"
                Margin="0,5,0,0"
                BackgroundColor="#B42318"
                TextColor="White"
                CornerRadius="10"
                IsVisible="False"
                Clicked="OnBorrarPublicacionClicked" />

            <Button
                x:Name="VolverPublicarButton"
                Text="📢 Volver a publicar"
                Margin="0,5,0,0"
                BackgroundColor="#2457C5"
                TextColor="White"
                CornerRadius="10"
                IsVisible="False"
                Clicked="OnVolverPublicarClicked" />

            <Button
                x:Name="ReactivarPublicacionButton"
                Text="🔄 Reactivar publicación"
                Margin="0,5,0,0"
                BackgroundColor="#218838"
                TextColor="White"
                CornerRadius="10"
                IsVisible="False"
                Clicked="OnReactivarPublicacionClicked" />
            
            <Button
                x:Name="MarcarDisponibleButton"
                Text="↩ Volver a marcar como disponible"
                Margin="0,5,0,0"
                BackgroundColor="#218838"
                TextColor="White"
                CornerRadius="10"
                IsVisible="False"
                Clicked="OnMarcarDisponibleClicked" />

            <Button
                x:Name="RegistrarVentaButton"
                Text="💰 Registrar venta"
                Margin="0,5,0,0"
                BackgroundColor="#2457C5"
                TextColor="White"
                CornerRadius="10"
                IsVisible="False"
                Clicked="OnRegistrarVentaClicked" />

            <Button
                x:Name="FavoritoButton"
                Text="♡ Agregar a favoritos"
                Margin="0,10,0,0"
                Clicked="OnAgregarFavoritoClicked" />

            <Button
                x:Name="ConversacionesPublicacionButton"
                Text="💬 Conversaciones de la publicación"
                Margin="0,10,0,0"
                IsVisible="False"
                Clicked="OnConversacionesPublicacionClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>


