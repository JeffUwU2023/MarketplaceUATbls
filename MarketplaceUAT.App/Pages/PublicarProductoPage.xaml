<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MarketplaceUAT.App.Pages.PublicarProductoPage"
    Title="Publicar producto">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="Publicar producto"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Completa la información de tu producto."
                FontSize="16"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,10" />

            <Entry
                x:Name="NombreEntry"
                Placeholder="Nombre del producto"
                MaxLength="100" />

            <Editor
                x:Name="DescripcionEditor"
                Placeholder="Descripción"
                MaxLength="500" />

            <Label
                x:Name="DescripcionContadorLabel"
                Text="0/500"
                FontSize="12"
                HorizontalOptions="End"
                TextColor="Gray" />
            
            <Entry
                x:Name="PrecioEntry"
                Placeholder="Precio"
                Keyboard="Numeric" />

            <Picker
                x:Name="CondicionPicker"
                Title="Selecciona la condición">

                <Picker.Items>
                    <x:String>Nuevo</x:String>
                    <x:String>Usado</x:String>
                </Picker.Items>

            </Picker>

            <Picker
                x:Name="CategoriaPicker"
                Title="Selecciona una categoría" />

            <Button
                Text="📷 Seleccionar imagen"
                Clicked="OnSeleccionarImagenClicked" />

            <Image
                x:Name="ImagenPreview"
                HeightRequest="200"
                Aspect="AspectFit"
                IsVisible="False" />

            <HorizontalStackLayout
                x:Name="MiniaturasLayout"
                Spacing="8"
                HorizontalOptions="Center"
                IsVisible="False" />

            <Button
                x:Name="PublicarButton"
                Text="Publicar producto"
                Clicked="OnPublicarClicked"
                Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>