<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MarketplaceUAT.App.Pages.EditarProductoPage"
    Title="Editar publicación">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="Editar publicación"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Modifica la información de tu producto."
                FontSize="16"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,10" />

            <Label
                Text="Nombre del producto"
                FontAttributes="Bold" />

            <Entry
                x:Name="NombreEntry"
                Placeholder="Nombre del producto"
                MaxLength="100" />

            <Label
                Text="Descripción"
                FontAttributes="Bold" />

            <Editor
                x:Name="DescripcionEditor"
                Placeholder="Descripción del producto"
                MaxLength="500"
                AutoSize="TextChanges"
                MinimumHeightRequest="150" />

            <Label
                Text="Precio"
                FontAttributes="Bold" />

            <Entry
                x:Name="PrecioEntry"
                Placeholder="Precio"
                Keyboard="Numeric" />

            <Label
                Text="Condición"
                FontAttributes="Bold" />

            <Picker
                x:Name="CondicionPicker"
                Title="Selecciona la condición">
                <Picker.Items>
                    <x:String>Nuevo</x:String>
                    <x:String>Usado</x:String>
                </Picker.Items>
            </Picker>
            <Label
                Text="Categoría"
                FontAttributes="Bold" />

            <Picker
                x:Name="CategoriaPicker"
                Title="Selecciona una categoría"
                ItemDisplayBinding="{Binding Nombre}" />

            <Label
                Text="Tipo de producto"
                FontAttributes="Bold" />

            <Picker
                x:Name="TipoProductoPicker"
                Title="Selecciona el tipo de producto"
                SelectedIndex="0"
                SelectedIndexChanged="OnTipoProductoChanged">

                <Picker.Items>
                    <x:String>Artículo único</x:String>
                    <x:String>Producto con varias unidades</x:String>
                </Picker.Items>
            </Picker>

            <Label
                x:Name="CantidadDisponibleLabel"
                Text="Cantidad disponible"
                FontAttributes="Bold"
                IsVisible="False" />

            <Entry
                x:Name="CantidadDisponibleEntry"
                Placeholder="Cantidad disponible"
                Keyboard="Numeric"
                IsVisible="False" />

            <Label
                Text="Imágenes del producto"
                FontAttributes="Bold" />

            <Image
                x:Name="ImagenPreview"
                HeightRequest="200"
                Aspect="AspectFit"
                IsVisible="False" />

            <HorizontalStackLayout
                x:Name="MiniaturasLayout"
                Spacing="8"
                HorizontalOptions="Center"
                IsVisible="False" />

            <Button
                Text="📷 Agregar imágenes"
                Clicked="OnAgregarImagenesClicked" />

            <Button
                Text="💾 Guardar cambios"
                Clicked="OnGuardarClicked"
                Margin="0,10,0,0" />

            <Button
                Text="Cancelar"
                Clicked="OnCancelarClicked"
                BackgroundColor="Transparent"
                TextColor="Gray" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>