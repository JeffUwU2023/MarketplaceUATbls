<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MarketplaceUAT.App.Pages.CarritoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Mi carrito"
    BackgroundColor="{AppThemeBinding Light=#F5F6FA, Dark=#15171C}">

    <Grid Padding="16" RowDefinitions="Auto,*">

        <Label
            Grid.Row="0"
            Text="Mi carrito"
            FontSize="26"
            FontAttributes="Bold"
            Margin="0,0,0,16"
            TextColor="{AppThemeBinding Light=#202124, Dark=White}" />

        <Grid Grid.Row="1">

            <CollectionView
                x:Name="CarritoCollection"
                IsVisible="False"
                SelectionMode="None"
                Scrolled="OnCarritoScrolled">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="12"
                            Margin="0,0,0,16"
                            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#383A40}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#202228}">

                            <VerticalStackLayout Spacing="12">

                                <!-- Encabezado del vendedor -->
                                <Label
                                    Text="{Binding NombreVendedor}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding Light=#202124, Dark=White}" />

                                <BoxView
                                    HeightRequest="1"
                                    Color="{AppThemeBinding Light=#E0E0E0, Dark=#383A40}" />

                                <!-- Productos de este vendedor -->
                                <VerticalStackLayout
                                    Spacing="12"
                                    BindableLayout.ItemsSource="{Binding Productos}">

                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="90,*"
                                                  ColumnSpacing="12">

                                                <Border
                                                    Grid.Column="0"
                                                    HeightRequest="90"
                                                    WidthRequest="90"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 8"
                                                    BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#303238}">

                                                    <Image
                                                        Source="{Binding ImagenUrl}"
                                                        Aspect="AspectFill" />
                                                </Border>

                                                <VerticalStackLayout
                                                    Grid.Column="1"
                                                    Spacing="5">

                                                    <Label
                                                        Text="{Binding Nombre}"
                                                        FontSize="16"
                                                        FontAttributes="Bold"
                                                        LineBreakMode="TailTruncation"
                                                        MaxLines="2"
                                                        TextColor="{AppThemeBinding Light=#202124, Dark=White}" />

                                                    <Label
                                                        Text="{Binding Condicion}"
                                                        FontSize="12"
                                                        TextColor="{AppThemeBinding Light=#666666, Dark=#BBBBBB}" />

                                                    <Label
                                                        Text="{Binding Precio, StringFormat='Precio: ${0:F2}'}"
                                                        FontSize="14"
                                                        TextColor="{AppThemeBinding Light=#444444, Dark=#DDDDDD}" />

                                                    <!-- Cantidad variable -->
                                                    <HorizontalStackLayout
                                                        Spacing="6"
                                                        VerticalOptions="Center"
                                                        IsVisible="{Binding PermiteCambiarCantidad}">

                                                        <Label
                                                            Text="Cantidad:"
                                                            FontSize="13"
                                                            VerticalTextAlignment="Center"
                                                            TextColor="{AppThemeBinding Light=#444444, Dark=#DDDDDD}" />

                                                        <Button
                                                            Text="−"
                                                            WidthRequest="34"
                                                            HeightRequest="34"
                                                            Padding="0"
                                                            CornerRadius="8"
                                                            CommandParameter="{Binding .}"
                                                            Clicked="OnDisminuirCantidadClicked" />

                                                        <Label
                                                            Text="{Binding Cantidad}"
                                                            FontSize="14"
                                                            FontAttributes="Bold"
                                                            VerticalTextAlignment="Center"
                                                            HorizontalTextAlignment="Center"
                                                            WidthRequest="24" />

                                                        <Button
                                                            Text="+"
                                                            WidthRequest="34"
                                                            HeightRequest="34"
                                                            Padding="0"
                                                            CornerRadius="8"
                                                            CommandParameter="{Binding .}"
                                                            Clicked="OnAumentarCantidadClicked" />
                                                    </HorizontalStackLayout>

                                                    <!-- Cantidad fija -->
                                                    <Label
                                                        Text="Cantidad: 1"
                                                        FontSize="13"
                                                        IsVisible="{Binding EsProductoUnico}"
                                                        TextColor="{AppThemeBinding Light=#444444, Dark=#DDDDDD}" />

                                                    <Label
                                                        Text="{Binding Subtotal, StringFormat='Subtotal del producto: ${0:F2}'}"
                                                        FontSize="14"
                                                        FontAttributes="Bold"
                                                        TextColor="{AppThemeBinding Light=#16803D, Dark=#75D69A}" />

                                                    <Label
                                                        Text="{Binding Estado}"
                                                        FontSize="12"
                                                        TextColor="{AppThemeBinding Light=#666666, Dark=#BBBBBB}" />

                                                    <!-- Disponibilidad -->
                                                    <Label
                                                        Text="{Binding MensajeDisponibilidad}"
                                                        IsVisible="{Binding MostrarAdvertencia}"
                                                        FontSize="13"
                                                        FontAttributes="Bold"
                                                        TextColor="#C62828"
                                                        LineBreakMode="WordWrap" />

                                                    <Grid
                                                        ColumnDefinitions="*,*"
                                                        ColumnSpacing="8"
                                                        Margin="0,4,0,0">

                                                        <Button
                                                            Grid.Column="0"
                                                            Text="Ver publicación"
                                                            FontSize="12"
                                                            Padding="8,7"
                                                            CornerRadius="8"
                                                            Clicked="OnVerPublicacionClicked"
                                                            CommandParameter="{Binding .}" />

                                                        <Button
                                                            Grid.Column="1"
                                                            Text="Quitar"
                                                            FontSize="12"
                                                            Padding="8,7"
                                                            CornerRadius="8"
                                                            BackgroundColor="#C62828"
                                                            TextColor="White"
                                                            Clicked="OnQuitarProductoClicked"
                                                            CommandParameter="{Binding .}" />

                                                    </Grid>
                                                </VerticalStackLayout>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <BoxView
                                    HeightRequest="1"
                                    Color="{AppThemeBinding Light=#E0E0E0, Dark=#383A40}" />

                                <!-- Subtotal independiente del vendedor -->
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">

                                    <Label
                                        Text="Total"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        VerticalTextAlignment="Center"
                                        TextColor="{AppThemeBinding Light=#202124, Dark=White}" />

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Subtotal, StringFormat='${0:F2}'}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        VerticalTextAlignment="Center"
                                        TextColor="{AppThemeBinding Light=#16803D, Dark=#75D69A}" />
                                </Grid>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Carrito vacío -->
            <VerticalStackLayout
                x:Name="SinCarritoLayout"
                IsVisible="True"
                Spacing="12"
                VerticalOptions="Center"
                HorizontalOptions="Center">

                <Label
                    Text="🛒"
                    FontSize="54"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Tu carrito está vacío"
                    FontSize="21"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    TextColor="{AppThemeBinding Light=#202124, Dark=White}" />

                <Label
                    Text="Agrega productos para verlos aquí."
                    FontSize="14"
                    HorizontalTextAlignment="Center"
                    TextColor="{AppThemeBinding Light=#666666, Dark=#BBBBBB}" />

            </VerticalStackLayout>

        </Grid>
    </Grid>
</ContentPage>
