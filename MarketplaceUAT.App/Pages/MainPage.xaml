<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:MarketplaceUAT.App.Converters"
    x:Class="MarketplaceUAT.App.Pages.MainPage"
    Title="Inicio"
    BackgroundColor="{AppThemeBinding Light=#F6F7F9, Dark=#151515}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:FavoritoCorazonConverter
            x:Key="FavoritoCorazonConverter" />
            <converters:CarritoIconoConverter 
            x:Key="CarritoIconoConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Encabezado -->
        <VerticalStackLayout
            Grid.Row="0"
            Padding="16,12,16,8"
            Spacing="12">

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">

                <VerticalStackLayout Grid.Column="0"
                                     Spacing="2"
                                     VerticalOptions="Center">
                    <Label Text="Marketplace"
                           FontSize="25"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#202124, Dark=#FFFFFF}"/>

                    <Label Text="Encuentra algo que te guste"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#BBBBBB}"/>
                </VerticalStackLayout>

                <Border Grid.Column="1"
                        x:Name="PerfilAvatarBorder"
                        WidthRequest="44"
                        HeightRequest="44"
                        Stroke="#DADADA"
                        StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#292929}"
                        StrokeShape="RoundRectangle 22"
                        IsVisible="False"
                        VerticalOptions="Center">

                    <Grid>
                        <Image x:Name="PerfilFotoImage"
                               Aspect="AspectFill"
                               IsVisible="False"/>

                        <Label x:Name="PerfilPlaceholder"
                               Text="👤"
                               FontSize="22"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Grid>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPerfilAvatarTapped"/>
                    </Border.GestureRecognizers>
                </Border>
            </Grid>

            <!-- Sesión -->
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">

                <Button x:Name="SesionButton"
                        Grid.Column="0"
                        Text="Iniciar sesión"
                        Clicked="OnSesionButtonClicked"
                        FontSize="13"
                        Padding="12,8"
                        CornerRadius="10"
                        HorizontalOptions="Fill"/>

                <Grid Grid.Column="1"
      VerticalOptions="Center">

                    <Button x:Name="ConversacionesButton"
            Text="💬 Chats"
            Clicked="OnConversacionesClicked"
            FontSize="13"
            Padding="10,8"
            CornerRadius="10"
            IsVisible="False"/>

                    <!-- Insignia de mensajes sin leer -->
                    <Border x:Name="ConversacionesBadge"
            WidthRequest="22"
            HeightRequest="22"
            BackgroundColor="#E53935"
            Stroke="#FFFFFF"
            StrokeThickness="1.5"
            StrokeShape="RoundRectangle 11"
            HorizontalOptions="End"
            VerticalOptions="Start"
            TranslationX="5"
            TranslationY="-5"
            ZIndex="1"
            InputTransparent="True"
            IsVisible="False">

                        <Label x:Name="ConversacionesBadgeLabel"
               Text="1"
               FontSize="11"
               FontAttributes="Bold"
               TextColor="#FFFFFF"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"/>
                    </Border>

                </Grid>
            </Grid>

            <!-- Barra de búsqueda -->
            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#292929}"
                    Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#444444}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="12,2">

                <Grid ColumnDefinitions="Auto,* ,Auto"
                      ColumnSpacing="8">

                    <Label Grid.Column="0"
                           Text="🔎"
                           FontSize="18"
                           VerticalOptions="Center"/>

                    <Entry x:Name="BuscarEntry"
                           Grid.Column="1"
                           Placeholder="¿Qué estás buscando?"
                           ReturnType="Search"
                           Completed="OnBuscarCompleted"
                           BackgroundColor="Transparent"
                           ClearButtonVisibility="WhileEditing"
                           VerticalOptions="Center"/>

                    <Button Grid.Column="2"
                            Text="Buscar"
                            Clicked="OnBuscarCompleted"
                            FontSize="13"
                            Padding="10,7"
                            CornerRadius="10"
                            VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- Accesos rápidos -->
            <ScrollView Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never">

                <HorizontalStackLayout Spacing="8">

                    <Button Text="Todas"
                            Clicked="OnTodasCategoriasClicked"
                            FontSize="12"
                            Padding="14,8"
                            CornerRadius="18"/>

                    <Button Text="Electrónica"
                            CommandParameter="1"
                            Clicked="OnCategoriaClicked"
                            FontSize="12"
                            Padding="12,8"
                            CornerRadius="18"/>

                    <Button Text="Libros"
                            CommandParameter="2"
                            Clicked="OnCategoriaClicked"
                            FontSize="12"
                            Padding="12,8"
                            CornerRadius="18"/>

                    <Button Text="Ropa"
                            CommandParameter="3"
                            Clicked="OnCategoriaClicked"
                            FontSize="12"
                            Padding="12,8"
                            CornerRadius="18"/>

                    <Button Text="Muebles"
                            CommandParameter="4"
                            Clicked="OnCategoriaClicked"
                            FontSize="12"
                            Padding="12,8"
                            CornerRadius="18"/>

                    <Button Text="Videojuegos"
                            CommandParameter="5"
                            Clicked="OnCategoriaClicked"
                            FontSize="12"
                            Padding="12,8"
                            CornerRadius="18"/>

                    <Button Text="Otros"
                            CommandParameter="6"
                            Clicked="OnCategoriaClicked"
                            FontSize="12"
                            Padding="12,8"
                            CornerRadius="18"/>

                </HorizontalStackLayout>
            </ScrollView>

            <!-- Acciones de usuario -->
            <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="*,*,*"
                  ColumnSpacing="8"
                  RowSpacing="8">

                <!-- Primera fila -->
                <Button Grid.Row="0"
            Grid.Column="0"
            Text="♡ Favoritos"
            Clicked="OnAbrirFavoritosClicked"
            FontSize="11"
            Padding="4,9"
            CornerRadius="10"/>

                <Button Grid.Row="0"
            Grid.Column="1"
            Text="＋ Publicar"
            Clicked="OnAbrirPublicarProductoClicked"
            FontSize="11"
            Padding="4,9"
            CornerRadius="10"/>

                <Button Grid.Row="0"
            Grid.Column="2"
            Text="Mis productos"
            Clicked="OnAbrirMisPublicacionesClicked"
            FontSize="11"
            Padding="4,9"
            CornerRadius="10"/>

                <!-- Segunda fila: solo con sesión iniciada -->

                <!-- Mis compras -->
                <Grid Grid.Row="1"
      Grid.Column="0"
      IsVisible="False"
      x:Name="MisComprasContenedor">

                    <Button x:Name="MisComprasButton"
            Text="Mis compras"
            Clicked="OnAbrirMisComprasClicked"
            FontSize="11"
            Padding="4,9"
            CornerRadius="10"
            IsVisible="True"/>

                    <Border x:Name="MisComprasBadge"
            WidthRequest="22"
            HeightRequest="22"
            BackgroundColor="#E53935"
            Stroke="#FFFFFF"
            StrokeThickness="1.5"
            StrokeShape="RoundRectangle 11"
            HorizontalOptions="End"
            VerticalOptions="Start"
            TranslationX="5"
            TranslationY="-5"
            ZIndex="1"
            InputTransparent="True"
            IsVisible="False">

                        <Label x:Name="MisComprasBadgeLabel"
               FontSize="11"
               FontAttributes="Bold"
               TextColor="#FFFFFF"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Mis ventas -->
                <Grid Grid.Row="1"
      Grid.Column="1"
      IsVisible="False"
      x:Name="MisVentasContenedor">

                    <Button x:Name="MisVentasButton"
            Text="Mis ventas"
            Clicked="OnAbrirMisVentasClicked"
            FontSize="11"
            Padding="4,9"
            CornerRadius="10"
            IsVisible="True"/>

                    <Border x:Name="MisVentasBadge"
            WidthRequest="22"
            HeightRequest="22"
            BackgroundColor="#E53935"
            Stroke="#FFFFFF"
            StrokeThickness="1.5"
            StrokeShape="RoundRectangle 11"
            HorizontalOptions="End"
            VerticalOptions="Start"
            TranslationX="5"
            TranslationY="-5"
            ZIndex="1"
            InputTransparent="True"
            IsVisible="False">

                        <Label x:Name="MisVentasBadgeLabel"
               FontSize="11"
               FontAttributes="Bold"
               TextColor="#FFFFFF"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"/>
                    </Border>
                </Grid>

                <Button x:Name="CarritoButton"
        Grid.Row="1"
        Grid.Column="2"
        Text="🛒 Mi carrito"
        Clicked="OnAbrirCarritoClicked"
        FontSize="11"
        Padding="4,9"
        CornerRadius="10"
        IsVisible="False"/>
                
            </Grid>

        </VerticalStackLayout>

        <!-- Productos -->
        <Grid Grid.Row="1"
              RowDefinitions="Auto,*"
              Padding="12,4,12,12"
              RowSpacing="8">

            <Label Grid.Row="0"
                   Text="Explora productos"
                   FontSize="19"
                   FontAttributes="Bold"
                   Margin="4,0,0,0"
                   TextColor="{AppThemeBinding Light=#202124, Dark=#FFFFFF}"/>

            <Grid Grid.Row="1">

                <CollectionView x:Name="ProductosCollection"
                                SelectionMode="None"
                                ItemsLayout="VerticalGrid, 3"
                                VerticalScrollBarVisibility="Default"
                                Scrolled="OnProductosScrolled">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="20"
                                             Spacing="8"
                                             VerticalOptions="Center"
                                             HorizontalOptions="Center">

                            <Label Text="No hay productos para mostrar"
                                   FontSize="16"
                                   HorizontalTextAlignment="Center"/>

                            <Label Text="Prueba otra categoría o vuelve a intentarlo más tarde."
                                   FontSize="13"
                                   TextColor="Gray"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border Margin="3"
                                    Padding="6"
                                    Stroke="{AppThemeBinding Light=#E2E2E2, Dark=#3A3A3A}"
                                    StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#242424}"
                                    StrokeShape="RoundRectangle 12">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnProductoTapped"/>
                                </Border.GestureRecognizers>


                                <Grid RowDefinitions="110,Auto,Auto,Auto"
                                      RowSpacing="4">

                                    <!-- Imagen y botón de favoritos -->
                                    <Grid Grid.Row="0">

                                        <Image Source="{Binding ImagenUrl}"
               Aspect="AspectFill"
               HeightRequest="110"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"/>

                                        <Button
            Text="{Binding EsFavorito, Converter={StaticResource FavoritoCorazonConverter}}"
            Clicked="OnFavoritoCorazonClicked"
            BackgroundColor="#FFFFFF"
            TextColor="#E53935"
            FontSize="20"
            Padding="0"
            WidthRequest="34"
            HeightRequest="34"
            CornerRadius="17"
            HorizontalOptions="End"
            VerticalOptions="Start"
            Margin="4"
            ZIndex="1"/>

                                        <Button Text="{Binding EstaEnCarrito, Converter={StaticResource CarritoIconoConverter}}"
        Clicked="OnCarritoProductoClicked"
        BackgroundColor="#FFFFFF"
        TextColor="#333333"
        FontSize="18"
        WidthRequest="38"
        HeightRequest="38"
        CornerRadius="19"
        Padding="0"
        HorizontalOptions="Start"
        VerticalOptions="Start"
        Margin="8" />

                                    </Grid>


                                    <Label Grid.Row="1"
                                           Text="{Binding Nombre}"
                                           FontSize="12"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}"
                                           VerticalOptions="Start"/>

                                    <Label Grid.Row="2"
                                           Text="{Binding Precio, StringFormat='{}{0:C}'}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#147D3F, Dark=#70D99A}"
                                           LineBreakMode="TailTruncation"/>

                                    <Label Grid.Row="3"
                                           Text="{Binding Condicion}"
                                           FontSize="10"
                                           TextColor="Gray"
                                           LineBreakMode="TailTruncation"/>

                                </Grid>
                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </Grid>
        </Grid>

    </Grid>
</ContentPage>
