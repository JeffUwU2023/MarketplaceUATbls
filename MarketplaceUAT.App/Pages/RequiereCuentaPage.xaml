<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MarketplaceUAT.App.Pages.RequiereCuentaPage"
    Title="Acceso">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="20"
            VerticalOptions="Center">

            <Label
                Text="🔐"
                FontSize="50"
                HorizontalOptions="Center" />

            <Label
                Text="Necesitas una cuenta"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <Label
                x:Name="MensajeLabel"
                Text="Para publicar productos y guardar favoritos necesitas iniciar sesión o crear una cuenta."
                FontSize="17"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,15" />

            <Button
                Text="Iniciar sesión"
                Clicked="OnIniciarSesionClicked" />

            <Button
                Text="Crear una cuenta"
                Clicked="OnCrearCuentaClicked" />

            <Button
                Text="Cancelar"
                Clicked="OnCancelarClicked"
                BackgroundColor="Transparent"
                TextColor="Gray" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>